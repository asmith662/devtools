  "verification_program": "\"\"\"Read-only retained-case verification; never re-enters a model or Tool.\"\"\"\nimport hashlib,json\nfrom pathlib import Path\nfrom devtools.core.time import Timestamp\nfrom devtools.models.interaction import ModelToolCall,Prompt,PromptMessage\nE=Path('experiments/local_maintenance_cohesion');D=E/'evidence'\ndef load(p):return json.loads(p.read_text(encoding='utf-8'))\nf=load(E/'freeze.json');r=load(D/'result.json');m=load(E/'measurements.json')\nv=dict(f);digest=v.pop('digest');assert hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':')).encode()).hexdigest()==digest\nfor name,h in f['files'].items():assert hashlib.sha256((E/name).read_bytes()).hexdigest()==h,name\nfor path,h in f['source_sha256'].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==h,path\nhist=r['messages'];all_calls={c['provider_call_id']:c for q in r['requests'] for c in q['response']['tool_calls']}\nall_feedback={x['tool_call_id']:x for x in hist if x['role']=='tool'}\nassert len(all_calls)==len(all_feedback)==11 and set(all_calls)==set(all_feedback)\ndef prompt(messages):\n return Prompt('', 'messages', tuple(PromptMessage(x['role'],x['content'],tuple(ModelToolCall(**c) for c in x['tool_calls']),x['tool_call_id'],x.get('reasoning_content')) for x in messages))\nprompt(hist)\nrows=[];consumed=set();seen={};reads=[]\nfor i,q in enumerate(r['requests'],1):\n sent=load(D/f'request-{i}.json');req=sent['request'];messages=req['prompt']['messages'];prompt(messages)\n p=r['projections'][i-1];assert req==p['request']\n size=len(json.dumps(req,ensure_ascii=False).encode());assert size==p['resulting_bytes']<=32768\n assert messages[0]['content']==f['objective']\n feedback={x['tool_call_id']:x for x in messages if x['role']=='tool'};consumed.update(feedback)\n for identity,msg in feedback.items():assert msg==all_feedback[identity]\n active=[]\n for option in p['active_sources']:\n  resource=option['unit']['resource'];path=resource['address']['value']\n  matches=[json.loads(x['content']) for x in feedback.values() if json.loads(x['content']).get('path')==path and json.loads(x['content']).get('span',[None])[0]==option['start']]\n  text=resource['content'][option['start']:option['end']].encode()[:option['maximum_bytes']].decode('utf-8',errors='ignore')\n  exact=[x for x in matches if x.get('text')==text and x.get('version')==resource['content_identity']['value'] and x.get('snapshot')==option['unit']['snapshot_id']['value']]\n  assert exact and list(exact[0]['span'])==[option['start'],option['start']+len(text)]\n  active.append(dict(path=path,snapshot=option['unit']['snapshot_id']['value'],version=resource['content_identity']['value'],requested_span=[option['start'],option['end']],span=exact[0]['span'],bytes=len(text.encode()),partial=exact[0]['partial']))\n m['projections'][i-1]['active_sources']=active\n calls=[]\n for c in q['response']['tool_calls']:\n  args=json.loads(c['arguments_json']);entry=dict(id=c['provider_call_id'],name=c['name'],arguments=args)\n  if c['name']=='read_source':\n   result=json.loads(all_feedback[c['provider_call_id']]['content']);path=args['path'];span=result['span'];text=result['text']\n   original=next(x for x in f['source_snapshot']['resources'] if x['address']['value']==path)['content']\n   assert original[span[0]:span[1]]==text and len(text.encode())<=8192\n   key=(path,*span);prior=seen.get(key);seen[key]=i\n   entry.update(span=span,bytes=len(text.encode()),partial=result['partial'],repeat_of_request=prior,requested_span=[args['start'],args.get('end',len(original))])\n   entry['previous_same_span_active_before_call']=any(x['path']==path and x['span']==span for x in active)\n   reads.append(dict(request=i,**entry))\n  calls.append(entry)\n rows.append(dict(request=i,original_bytes=p['original_bytes'],active_bytes=size,status=p['status'],input_tokens=q['response']['usage']['input_tokens'],output_tokens=q['response']['usage']['output_tokens'],seconds=q['seconds'],active_sources=active,omitted_exchanges=p['omitted_exchanges'],calls=calls))\nfor read in reads:read['feedback_consumed_later']=read['id'] in consumed\nassert not r['proposals'] and not r['applied'] and not r['procedures']\nassert r['result']['disposition']=='model_limit' and not r['accepted'] and r['result']['custody']['restored']\nassert all(e['acknowledged'] for e in r['result']['progress']['effects'])\ncandidate=load(D/'candidate.json');assert set(candidate)==set(f['editable'])\nfor p,a in candidate.items():assert a['content_utf8'].encode()==bytes.fromhex(f['baseline_raw'][p]) and a['unchanged']\nreview=load(E/'independent-review.json');assert not review['passes_frozen_behavior'] and review['restored']\nassert len(review['focused']['failed'])==3 and len(review['heldout']['failed'])==5\nm['measurement_qualification']='Active source span is the actually presented UTF-8-bounded Context disclosure, not SourceRangeDisclosureOption.end (the requested end). Requested and actual spans are recorded separately. Original evidence is unchanged.'\n(E/'measurements.json').write_text(json.dumps(m,indent=2)+'\\n')\nout=dict(at=str(Timestamp.now()),status='passed',freeze=digest,model_requests=10,native_calls=11,source_reads=len(reads),unique_source_spans=len(seen),repeated_reads=sum(x['repeat_of_request'] is not None for x in reads),unconsumed_feedback=sorted(set(all_feedback)-consumed),rows=rows,reads=reads,source_unchanged=True,native_correlation_valid=True,source_correspondence_valid=True,checks_repeated=False,automatic_model_or_tool_reexecution=False,heldout_result='Five intended behavioral failures, one authority control pass; no errors/skips',qualification='Effect-free evidence reconstruction. Repeated reads were independently model-selected native calls, not harness replay. This does not infer model reasoning or prove a counterfactual strategy would succeed.',verification_command=['uv','run','python','.local/host-cohesion/verify_case.py'],verification_program=Path(__file__).read_text(enc